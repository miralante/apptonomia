# Cloudflare Workers static assets custom headers
# (https://developers.cloudflare.com/workers/static-assets/headers/).
#
# Apptonomia is a fully static portal that links out to six sibling
# projects (Calculia, Routime, Okeymoney, Sinonimia, Memofun, Teclatlon).
# No API, no user data, no third-party runtime CDN — the headers here
# mirror sinonimia's policy and are written to:
#   1. Block the most common web attack classes (clickjacking, MIME
#      sniffing, mixed content).
#   2. Lock down a minimal-but-correct CSP that allows what the app
#      actually does:
#        - bootstrap.js + script.js + strings.es.js + strings.en.js,
#          all served from the same origin (so script-src 'self')
#        - inline <style>...</style> in <head> plus inline `style.X =`
#          writes done by the bootstrap (so style-src 'self' 'unsafe-inline')
#        - the JSON-LD <script type="application/ld+json"> block is
#          parsed as data, not executed, so script-src does not apply
#          to it.
#        - emoji pictograms come from no source at all (they are text
#          glyphs in the page), so img-src can stay tight at 'self' + data:.
#        - system fonts only (Google Fonts was removed in favour of
#          system-ui), so font-src can stay at 'self' + data:.
#        - no XHR/fetch, no service workers, no <object>/<embed>.
#   3. Long-cache the immutable assets (CSS/JS) so users don't re-download
#      the i18n bundles on every visit. index.html is no-cache because
#      its [data-i18n] attributes must stay in lock-step with the JS
#      bundles; a stale immutable index.html + fresh JS can render
#      literal key names instead of text (cf. sinonimia's
#      `?v=`-on-`i18n.js` cache-bust footnote in its own _headers).

# ---------------------------------------------------------------------------
# Security headers — applied to every response, including HTML.
# ---------------------------------------------------------------------------
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  # Hides the full URL (which may contain a search query in the future)
  # from cross-origin Referer headers.
  Referrer-Policy: strict-origin-when-cross-origin
  # Disable features we don't use. Cheap, belt-and-braces hardening.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), midi=()
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Opener-Policy: same-origin
  # Upgrade any accidental http:// subresources to https.
  Upgrade-Insecure-Requests: 1
  # Strict CSP. Directives:
  #   default-src 'self'                          — deny everything by default
  #   script-src 'self'                           — bootstrap.js + script.js +
  #                                                strings.es.js + strings.en.js,
  #                                                all served from this origin.
  #                                                The JSON-LD <script
  #                                                type="application/ld+json">
  #                                                block in index.html is
  #                                                parsed as data (it's not a
  #                                                JavaScript MIME type), so it
  #                                                does not require 'unsafe-inline'.
  #   style-src 'self' 'unsafe-inline'            — the inline <style> in
  #                                                <head> (design tokens + layout)
  #                                                AND any inline `element.style.X =`
  #                                                writes done by script.js
  #                                                (e.g. aria-pressed toggles).
  #   img-src 'self' data:                        — favicon data: + any future
  #                                                image hosted on the same origin.
  #                                                No third-party CDN: emoji
  #                                                pictograms are Unicode glyphs,
  #                                                not images.
  #   font-src 'self' data:                       — system fonts + inline data: URIs
  #                                                only (Google Fonts removed).
  #   connect-src 'self'                          — no XHR/fetch to third parties
  #   worker-src 'none'                           — no service workers
  #   manifest-src 'self'                         — in case we add a PWA manifest
  #                                                later
  #   object-src 'none'                           — no <object>/<embed>/<applet>
  #   base-uri 'self'                             — block <base> hijacking
  #   form-action 'self'                          — block form submission to third
  #                                                parties
  #   frame-ancestors 'none'                      — supersedes X-Frame-Options
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'none'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# ---------------------------------------------------------------------------
# Cache policy per asset type.
#
# index.html is `no-cache` because its [data-i18n] attributes must stay
# in lock-step with strings.*.js — a stale immutable index.html served
# alongside fresh strings would render literal key names. The JS bundles
# are `immutable` for a year because they are content-hashed: when the
# bundle content changes, the filename changes (`strings.es.js` itself
# is the cache key here, no query strings needed because they are tiny
# and there are only two of them — if this ever grows past ~5 bundles,
# revisit and switch to a content hash in the filename instead of a
# version bump in wrangler.toml's `compatibility_date`).
#
# css/styles.css is also `immutable` for a year, BUT index.html carries
# a `?v=<date>` cache-bust suffix on the <link rel="stylesheet"> tag so
# a content change to the CSS forces every browser to re-fetch. Bump the
# date suffix in `index.html` in the same commit that touches
# css/styles.css — same contract as the PWA siblings' sw.js VERSION
# (see CLAUDE.md §"Metaproject agent rules" §5). Without this, Safari
# iOS in particular keeps the old stylesheet across visits for the full
# year, even after a deploy, and renders long unbroken tokens (domain
# names in the suite grid, …) with stale metrics.
# ---------------------------------------------------------------------------
/index.html
  Cache-Control: no-cache

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

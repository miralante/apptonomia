# Sistema operativo / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
# Ficheros scratch de sesiones del editor / agente
.tmp*
# Notas/workspace personal del mantenedor
,dev/
.dev/
# Configuración local de Claude Code (skills descargados, settings).
# Se regeneran desde ~/.claude/skills/ si hace falta.
.claude/
# Caché local de Wrangler CLI (deployments, logs).
.wrangler/

# Por si en el futuro alguien añade alguna herramienta con dependencias
node_modules/
npm-debug.log*

# Artefactos de agentes/herramientas de IA (se regeneran localmente)
graphify-out/
graphify-out-meta/
.graphifyignore

# Cachés que generan los scripts de mantenimiento
scripts/.cache/

# Logs de servidores de desarrollo locales
*.log

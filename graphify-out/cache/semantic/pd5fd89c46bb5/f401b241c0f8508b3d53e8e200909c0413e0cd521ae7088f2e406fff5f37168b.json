{"nodes": [{"id": "doc_es_spec", "label": "SPEC.md \u2014 Definici\u00f3n del producto (ES)", "file_type": "document", "source_file": "doc/es/SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_es_spec_six_therapeutic_modules", "label": "Six Therapeutic Modules system", "file_type": "concept", "source_file": "doc/es/SPEC.md", "source_location": "\u00a72.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Activities are grouped into 6 therapeutic areas so the landing stays navigable (4-6 options rule) while covering coordination, autonomy, memory, reasoning, language and emotions; an activity may serve more than one area but appears once, under its primary module."}, {"id": "doc_es_spec_progress_storage_contract", "label": "Local progress/storage contract (estrellas, completado, localStorage only)", "file_type": "rationale", "source_file": "doc/es/SPEC.md", "source_location": "\u00a73.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Privacy-by-default: only `estrellas` (integer) and `completado` (finished levels) plus a few explicit optional fields are ever stored; failures, time spent, attempt counts, comparisons and identifiable profiles are never saved, and progress never leaves the device or syncs to the cloud."}, {"id": "doc_es_spec_no_pressure_principle", "label": "No-pressure / error-never-punishes principle", "file_type": "rationale", "source_file": "doc/es/SPEC.md", "source_location": "\u00a73.1-\u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No stars or progress are ever subtracted, failure only triggers an encouragement message (never 'incorrect'), retries are unlimited, and Socratic hints precede answers \u2014 because the product exists so a person with intellectual disability can practice without fear of visible failure."}, {"id": "doc_
{
  "name": "apptonomia",
  "version": "1.0.0",
  "description": "Training platform for occupational therapy",
  "scripts": {
    "dev": "echo 'Use site/index.html directly or a local server'",
    "start": "python -m http.server 8080",
    "check": "node scripts/check.js",
    "smoke": "node scripts/smoke.js",
    "test:cross": "node scripts/cross-browser.js",
    "test": "node scripts/check.js && node scripts/smoke.js && node scripts/cross-browser.js",
    "refactor:i18n": "node scripts/refactor-i18n.js",
    "scan:secrets": "node scripts/scan-secrets.js",
    "scan:secrets:all": "node scripts/scan-secrets.js --all",
    "scan:secrets:install": "node scripts/scan-secrets.js --install",
    "prepush": "node scripts/scan-secrets.js --pre-push",
    "firebase:login": "firebase login",
    "firebase:init": "firebase init",
    "firebase:deploy": "firebase deploy",
    "firebase:hosting": "firebase hosting:channel:deploy preview"
  },
  "keywords": [
    "therapy",
    "training",
    "accessibility"
  ],
  "author": "The Naked Frame",
  "license": "MIT",
  "devDependencies": {
    "firebase-tools": "^15.24.0",
    "playwright": "^1.61.1"
  }
}
